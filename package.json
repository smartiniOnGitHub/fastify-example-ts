{
  "name": "fastify-example-ts",
  "version": "5.0.0",
  "description": "Example web application with Fastify, made in TypeScript",
  "main": "dist/server",
  "scripts": {
    "audit:log": "npm audit > ./temp/audit.log",
    "build:clean": "npm run clean:dist",
    "build:dev": "tsc -p tsconfig.build.json --watch",
    "build:prod": "npm run clean:dist && tsc -p tsconfig.build.json",
    "build:show": "clear && npm run show:dist",
    "build:type-check": "tsc --noEmit",
    "build": "npm run build:dev",
    "cache:cleanup": "npm cache clean --force",
    "cache:verify": "npm cache verify",
    "clean:all": "npm run clean:dist && npm run clean:install && npm run clean:log",
    "clean:dist": "rm -rf dist/*",
    "clean:install": "rm -rf ./package-lock.json ./node_modules/",
    "clean:log": "rm -rf ./*.log",
    "clean": "npm run clean:dist && npm run clean:log",
    "debug:dev": "nodemon --debug --watch src ./src/server",
    "debug": "node --inspect ./src/server",
    "dependency:log": "npm list > ./temp/dependencies.log",
    "dist:build": "clear && npm run dist:clean && npm run build:prod && npm run dist:show",
    "dist:clean": "npm run clean:dist",
    "dist:show": "clear && npm run show:dist",
    "docs:clean": "rm -rf ./out/*",
    "docs:generate": "npx jsdoc -c .jsdoc.json -R README.md",
    "docs": "npm run docs:clean && npm run docs:generate",
    "format": "npm run lint:js:fix",
    "healthcheck-manual": "node node_modules/fastify-healthcheck/src/healthcheck http://localhost:8000/health",
    "lint:all": "npm run lint:js && npm run lint:ts && npm run lint:ts:types",
    "lint:js:fix": "standard --fix",
    "lint:js": "standard --verbose",
    "lint:ts:types:fix": "eslint -c types/.eslintrc.json types/*.d.ts types/*.test-d.ts --fix",
    "lint:ts:types": "eslint -c types/.eslintrc.json types/*/*.d.ts test/types/*/*.test-d.ts",
    "lint:ts": "standard --parser @typescript-eslint/parser --plugin @typescript-eslint/eslint-plugin test/*.ts",
    "lint": "npm run lint:js && npm run lint:ts",
    "postinstall": "",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build:prod",
    "prestart": "",
    "pretest": "npm run lint",
    "show:dist": "ls -l ./dist",
    "start:clean-and-build": "npm run clean && npm run build:prod",
    "start:debug": "node --inspect-brk ./src/server",
    "start:minimal": "npm run start:clean-and-build && node ./dist/server-minimal",
    "start:prod": "npm run start:clean-and-build && npm run start",
    "start:simple": "npm run start:clean-and-build && node ./dist/server-simple",
    "start": "node ./dist/server",
    "test:clean": "rm -rf .nyc_output/* .tap/* ./coverage/*",
    "test:coverage:all": "npm run test:unit --  --coverage-report=text",
    "test:coverage": "npm run test:unit -- --coverage-report=html",
    "test:dev": "npm run test:clean && npm run test:unit:dev",
    "test:unit:debug": "npm run build && tap -T --node-arg=--inspect-brk",
    "test:unit:dev": "npm run build && tap --watch --coverage-report=none",
    "test:unit:with-snapshot": "cross-env TAP_SNAPSHOT=1 npm run build && npm run test:unit",
    "test:unit": "npm run build && tap --allow-incomplete-coverage",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^11.1.1",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "fast-json-stringify": "^6.4.0",
    "fastify-favicon": "^5.0.0",
    "fastify-healthcheck": "^5.1.0",
    "fastify-nats-client": "^5.0.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/tap": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "cross-env": "^10.1.0",
    "jsdoc": "^4.0.5",
    "nodemon": "^3.1.14",
    "simple-get": "^4.0.1",
    "standard": "^17.1.2",
    "tap": "^21.7.2",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {},
  "type": "commonjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "tsd": {
    "directory": "types",
    "compilerOptions": {
      "esModuleInterop": true,
      "strict": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartiniOnGitHub/fastify-example-ts.git"
  },
  "keywords": [
    "node",
    "example",
    "fastify",
    "ejs",
    "es14",
    "es2023",
    "typescript"
  ],
  "author": "Sandro Martini <sandro.martini@gmail.com>",
  "license": "Apache-2.0"
}
